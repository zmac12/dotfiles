// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "ssh_connections": [
    {
      "host": "desktop-d07c1bh-1.tail0d4fc1.ts.net",
      "username": "zach",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/zach"
          ]
        }
      ]
    }
  ],
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "proxy": "",
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  /* Duplicated key auto-commented: "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  }, */
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "default_model": {
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-5.3-codex"
    },
  },
  "features": {
    "copilot": true
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "theme": "One Dark Pro",
  "ui_font_size": 12,
  "buffer_font_size": 12.0,
  "buffer_font_family": "Monaspace Neon",
  "ui_font_family": "Monaspace Neon",
  "language_overrides": {
    "Python": {
      "format_on_save": {
        "external": {
          "command": "ruff",
          "arguments": [
            "check",
            "--exit-zero",
            "--fix",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    }
  }
}
